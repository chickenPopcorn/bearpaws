//=====================================

// This file was created with reference to "Salamander Grand Piano V3.sfz" at
// https://github.com/sfzinstruments/SalamanderGrandPiano/.
// Please refer to this file if you want to make full use of SFZ v2 standard.

// To enable "Sampled Release", "Hammer Noise", "Pedal Noise", and
// "Pedal Resonance", set CC20=1...127, CC21=1...127, CC22=1...127, and
// CC23=1...127 respectively.

// To change the release length, set CC72 to 1 or higher.  CC72=127 will
// extend the release time by 2 seconds.

// Warning: Software that is not yet fully SFZ v2 compatible often fails to
//          process CC64 correctly when Sampled_release/Hammer_noise is
//          enabled.  To avoid this problem, we recommend turning off CC20
//          and CC21 in such software.

// Info: The following MIDI CCxx default values (=> 1 for enabled) apply to
//       SFZ v2 software only.  In software that is not yet fully SFZ v2,
//       initial CC[20,21,22,23,24] values are 0 (<control> section is
//       ignored).
//
<control>
//        Vol          Pan           Veltrack
          set_cc7=100  set_cc10=64   set_cc99=0
//        Sampled rel  Hammer noise  Pedal noise  Pedal res   Note att    Release len
          set_cc20=0   set_cc21=0    set_cc22=0   set_cc23=0  set_cc24=0  set_cc72=0
label_cc7=Vol
label_cc10=Pan
label_cc20=Sampled Release
label_cc21=Hammer Noise
label_cc22=Pedal Noise
label_cc23=Pedal Resonance
label_cc24=Note Attenuation
label_cc64=Sus Pedal
label_cc72=Release Length
label_cc99=Veltrack

// Info: "ampeg_release" and "off_time" in the <global> section determine the
//       base release time.  These should basically be the same value.

// Note: "ampeg_release_shape" seems to behave differently depending on the
//       player/sampler software.

<global>
amp_veltrack=98.5
amp_veltrack_oncc99=-50
amp_veltrack_curvecc99=0  // 0 to 1 (Linear); see https://sfzformat.com/headers/curve/
note_polyphony=1
ampeg_release=0.5
off_time=0.5
amplitude_oncc7=100
amplitude_curvecc7=4
pan_oncc10=100
pan_curvecc10=1

// Damper pedal settings for live performance.  (suggested by
// Andrew <https://github.com/esesur> and Peter <https://github.com/peastman>)
//
// The settings here are only valid when certain conditions are met.
//   1. Using specific player/sampler software such as Sforzand, Sfizz, etc.
//   2. The Sus Pedal outputs continuous values from 0 to 127.
//      (e.g., YAMAHA Disklavier, Clavinova, P-525, CP88, YC88, etc.)
// 1. + 2. : "Half pedaling" is supported.
// 1. only : "Repedaling" is supported.

// Reset default CC64 implementation.
// Note: Sus pedal is controlled by CC64 even if the following line is enabled.
sustain_cc=90

ampeg_dynamic=1
ampeg_releasecc64=100

// The curve with curve_index=11 is applied for half pedaling (note).
ampeg_release_curvecc64=11

// The subtle behavior of half pedaling is set by the following line:
// (These parameters were calibrated using YAMAHA EA1 Disklavier grand piano)
<curve> curve_index=11  // for note
v000=0
v032=0
v042=.1
v054=.3
v062=.4
v064=1
v127=1

<curve> curve_index=12  // for pseudo pedal resonance
v000=0
v022=0
v032=.3
v062=.8
v064=1
v127=1

//Notes

<master> ampeg_release_oncc72=2
hicc24=126
volume_oncc24=-48
volume_curvecc24=0  // 0 to 1 (Linear); see https://sfzformat.com/headers/curve/

