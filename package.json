{
  "name": "pawpal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write src tests e2e scripts *.json *.ts *.js index.html README.md docs/*.md",
    "format:check": "prettier --check src tests e2e scripts *.json *.ts *.js index.html README.md docs/*.md",
    "example": "node scripts/create-example.mjs",
    "library:pull": "node scripts/library.mjs pull",
    "library:push": "node scripts/library.mjs push"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "midi-file": "^1.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
